#include <WiFi.h>
#include <PubSubClient.h>

// --- Network & Server Configurations ---
const char* ssid        = "YOUR_WIFI_NAME";         // Your Wi-Fi Name
const char* password    = "YOUR_WIFI_PASSWORD";     // Your Wi-Fi Password
const char* mqtt_server = "192.168.X.X";           // IMPORTANT: Put your Android phone's local network IP here!
const int mqtt_port     = 1883;

// --- Pin Definitions for UNIHIKER K10 ---
// P0 and P1 are the full-function IO pins exposed via the K10 ports.
// We will simulate a sensor value and log data back over MQTT.
const int LED_PIN = P0; // Set to P0 or P1 to control an external LED or peripheral

WiFiClient espClient;
PubSubClient client(espClient);
unsigned long lastMsg = 0;

// --- Callback function: Triggered when Node-RED sends data to K10 ---
void callback(char* topic, byte* payload, unsigned int length) {
  String message = "";
  for (int i = 0; i < length; i++) {
    message += (char)payload[i];
  }
  
  // Check the message coming from the Node-RED phone button
  if (String(topic) == "unihiker/k10/led") {
    if (message == "toggle" || message == "true") {
      digitalWrite(LED_PIN, !digitalRead(LED_PIN)); // Toggle Pin P0 State
    }
  }
}

void setup_wifi() {
  delay(10);
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) {
    delay(500);
  }
}

// Ensure connection remains stable
void reconnect() {
  while (!client.connected()) {
    if (client.connect("UnihikerK10Client")) {
      // Subscribe to the topic coming from the phone's browser UI button
      client.subscribe("unihiker/k10/led");
    } else {
      delay(5000);
    }
  }
}

void setup() {
  Serial.begin(115200);
  pinMode(LED_PIN, OUTPUT);
  
  setup_wifi();
  client.setServer(mqtt_server, mqtt_port);
  client.setCallback(callback);
}

void loop() {
  if (!client.connected()) {
    reconnect();
  }
  client.loop();

  // --- Send Data Lane: Publish a simulated value to Node-RED every 2 seconds ---
  unsigned long now = millis();
  if (now - lastMsg > 2000) {
    lastMsg = now;
    
    // Simulate a changing sensor reading (e.g., light value mapping)
    int simulatedSensorValue = random(100, 800); 
    String payload = String(simulatedSensorValue);
    
    // Publish data up to the Phone's Termux broker
    client.publish("unihiker/k10/light", payload.c_str());
  }
}
